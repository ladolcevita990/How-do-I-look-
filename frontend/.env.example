# Copy to .env.local for local dev, or add these to Vercel's Environment Variables.
# Both keys are publicly shipped to the browser; that's fine because row-level
# security + the uuid-scoped session id keep sessions isolated.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
