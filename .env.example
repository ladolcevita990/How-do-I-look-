# ---- Try-on backend ----
# "stub" uses a local PIL compositor (no API keys, free, good for development).
# "replicate" uses IDM-VTON via Replicate (realistic results, costs ~$0.03/call).
TRYON_BACKEND=stub

# Replicate API (only required if TRYON_BACKEND=replicate)
REPLICATE_API_TOKEN=

# SerpAPI (optional — for Google Shopping garment search; scraping by URL works without it)
SERPAPI_KEY=

# ---- Session cookie ----
# Used to sign the long-lived session cookie. Generate a random 32+ char string for production.
SESSION_COOKIE_SECRET=dev-change-me-please-dev-change-me-please
# Set to "true" in any HTTPS deploy. Required when SESSION_COOKIE_SAMESITE=none.
SESSION_COOKIE_SECURE=false
# "lax" for same-origin local dev. "none" for cross-origin prod (Vercel + Render).
SESSION_COOKIE_SAMESITE=lax

# ---- Storage ----
# "local" = write files under LOCAL_STORAGE_DIR (use this on Render with a disk).
# "s3"    = talk to an S3-compatible API (MinIO in docker-compose, AWS S3, Cloudflare R2).
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=./data/files

# S3 settings (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=howdoilook

# ---- URLs ----
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Comma-separated list of additional origins allowed by CORS (e.g. Vercel preview URLs).
CORS_EXTRA_ORIGINS=

# ---- Database ----
DATABASE_URL=sqlite:///./data/howdoilook.db
