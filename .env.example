# How Do I Look? — environment variables
#
# The frontend is the entire app. It talks directly to Supabase from the
# browser using the public anon key, and composites outfits on-device.
# There is no backend to run.
#
# Copy this file to frontend/.env.local and fill in the two Supabase values.

# ---- Supabase ----
# Create a free project at https://supabase.com, then:
#   1. Settings → API → copy the Project URL and anon/public key below.
#   2. SQL Editor → paste frontend/supabase-schema.sql → Run.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
